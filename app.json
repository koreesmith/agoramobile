{
  "expo": {
    "name": "Agora",
    "slug": "agoramobile",
    "version": "6.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#486581"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "social.agora.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to take photos and record videos for posts, reels and your profile.",
        "NSMicrophoneUsageDescription": "Used to record sound when you record a video for a reel or post.",
        "NSPhotoLibraryUsageDescription": "Used to choose photos and videos for posts, reels and your profile.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#486581"
      },
      "package": "social.agora.app",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "./plugins/withIOS26ClassPrewarm",
      "./plugins/withTurboModuleVoidExceptionGuard",
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      "expo-video",
      "expo-web-browser"
    ],
    "scheme": "agoramobile",
    "extra": {
      "eas": {
        "projectId": "2ab559d5-3b6d-48ef-a16f-b5730b983802"
      }
    }
  }
}
